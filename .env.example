# Chave da API Gemini (obrigatória para classificação semântica dos campos)
GEMINI_API_KEY=sua_chave_aqui

# ============================================================
#  SEGURANÇA: SUBMISSÃO DE FORMULÁRIOS
# ============================================================
#  Por padrão o agente NUNCA submete formulários — preenche
#  os campos e para antes de clicar em Submit/Enviar.
#
#  Mude para true SOMENTE em ambiente de produção autorizado,
#  após validar manualmente os dados gerados para cada portal.
#
#  false  →  preenche e para (seguro para testes/desenvolvimento)
#  true   →  clica em Submit e envia os dados ao portal
# ============================================================
ALLOW_FORM_SUBMIT=false
